# Registry API (Railway or local)
NEXT_PUBLIC_REGISTRY_URL=http://localhost:8080

# Clerk — https://dashboard.clerk.com
# Dashboard → Configure → Email, phone, username: enable Email (separate from Google SSO)
# Dashboard → Configure → Paths: add http://localhost:3000 and your production URL
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Modal sign-in; /sign-in and /sign-up open the same modal. OAuth uses redirect + /sign-in/continue.
# Clerk Dashboard: Username should be Optional (registry username is set in /account).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Cursor SDK / Cloud Agents API — Workflow Studio (server-only)
CURSOR_API_KEY=
# Vercel uses the REST API automatically. Set to 1 to force API locally too.
# CURSOR_WORKFLOW_USE_API=1

# Workflow Studio rate limit (per signed-in Clerk user)
# Default: 3 requests per hour. Uses in-memory store locally; set Upstash
# in production (Vercel/serverless) so limits apply across instances.
STUDIO_RATE_LIMIT_MAX=3
STUDIO_RATE_LIMIT_WINDOW=1 h
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
