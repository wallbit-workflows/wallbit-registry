# Registry API (Railway or local)
NEXT_PUBLIC_REGISTRY_URL=http://localhost:8080

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Modal auth uses /sign-in and /sign-up only for middleware redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Cursor SDK / Cloud Agents API — Workflow Studio (server-only)
CURSOR_API_KEY=
